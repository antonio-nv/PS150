<Window x:Class="PS150.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="PS150" Height="450" Width="800"
        Background="Black"
        KeyDown="MainWindow_KeyDown"
        MouseWheel="MainWindow_MouseWheel"
        MouseMove="MainWindow_MouseMove">
    <Grid>
        <!-- Nahrazeno z MediaElement na VLC VideoView -->
        <vlc:VideoView x:Name="VideoViewer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</Window>