<Window x:Class="PS150.UI.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ShowActivated="False"
        Focusable="False">
    <!-- Background="Transparent" (ne null!) je záměr - ve WPF i čistě
         průhledný, ale NENULLOVÝ štětec je pořád "hit-testovatelný", takže
         MouseMove přes tohle okno funguje i tam, kde nic vidět není -
         potřebujeme to kvůli SetClickThrough/Grid_MouseMove níž. -->
    <Grid Background="Transparent" MouseMove="Grid_MouseMove">
        <!-- Horní panel: cesta + jméno souboru -->
        <Border x:Name="FileInfoOverlay"
                Background="#AA000000"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Padding="20,12"
                Opacity="0" Visibility="Collapsed">
            <TextBlock x:Name="FileInfoText"
                       Foreground="White" FontSize="16"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </Border>

        <!-- Dolní panel: čas, šoupátko, hlasitost (jen číslo, žádné druhé šoupátko) -->
        <Border x:Name="SeekOverlay"
                Background="#AA000000"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Padding="20,12"
                Opacity="0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText" Grid.Column="0"
                           Foreground="White" FontSize="14" VerticalAlignment="Center"
                           Margin="0,0,14,0" Text="00:00"/>

                <Slider x:Name="SeekSlider" Grid.Column="1"
                        Minimum="0" Maximum="1000" VerticalAlignment="Center"
                        IsMoveToPointEnabled="True"
                        Thumb.DragStarted="SeekSlider_DragStarted"
                        Thumb.DragCompleted="SeekSlider_DragCompleted"
                        ValueChanged="SeekSlider_ValueChanged"/>

                <TextBlock x:Name="TotalTimeText" Grid.Column="2"
                           Foreground="White" FontSize="14" VerticalAlignment="Center"
                           Margin="14,0,24,0" Text="00:00"/>

                <TextBlock x:Name="VolumeText" Grid.Column="3"
                           Foreground="White" FontSize="14" VerticalAlignment="Center"
                           Text="Hlasitost: 100 %"/>
            </Grid>
        </Border>
    </Grid>
</Window>
