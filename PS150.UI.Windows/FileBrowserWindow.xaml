<Window x:Class="PS150.UI.Windows.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♪♫ PS150 Player."
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <!--
        ResizeMode="CanMinimize" - stejné jako u obyčejného okna: minimalizace
        a zavření jdou, maximalizační tlačítko je vidět, ale je zašedlé/neaktivní
        (WPF ho takhle kreslí samo, není potřeba žádný P/Invoke trik jako
        dřív v konzoli). SizeToContent necháváme okno samo spočítat přesnou
        velikost podle textové mřížky (viz FileBrowserWindow.xaml.cs) - mění
        se to podle počtu řádků (MIDI kanály / zalomená cesta), stejně jako
        se dřív měnila výška konzole, jen bez toho původního console bugu.
    -->
    <Canvas x:Name="RootCanvas" Background="Black"/>
</Window>
