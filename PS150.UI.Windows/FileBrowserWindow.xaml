<Window x:Class="PS150.UI.Windows.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♪♫ PS150 Player."
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStyle="None"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseWheel="Window_MouseWheel"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <!--
        NOVÉ: WindowStyle="None" - systémový titulek se nekreslí, titulek, [_] a [X]
        jsou vykreslené v textové mřížce (řádek 0, viz RenderDashboard) a klikání
        na ně / tažení za titulek řeší Window_MouseLeftButtonDown.

        RotationHost: sem se klávesou r nastavuje LayoutTransform (otočení o 90 stupňů).
        LayoutTransform (na rozdíl od RenderTransform) otočí i rozměry při výpočtu
        rozvržení, takže si okno (SizeToContent) samo vezme tvar vysokého úzkého
        pruhu; klikání myší funguje v otočeném stavu beze změny.

        Border kolem dokola je jen tenký rámeček, ať je okno bez systémového
        titulku vidět na tmavém pozadí.
    -->
    <Border BorderBrush="#FF007070" BorderThickness="1" Background="Black">
        <Grid x:Name="RotationHost">
            <Canvas x:Name="RootCanvas" Background="Black"/>
        </Grid>
    </Border>
</Window>
